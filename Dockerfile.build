# syntax=docker/dockerfile:1
#
# Multi-stage portable Linux build for zkminer binaries.
# Usage: docker build -f Dockerfile.build --target dist-cli --output type=local,dest=dist/ .
#
# All binaries link against glibc 2.35 (Ubuntu 22.04) for broad compatibility. What a host needs
# beyond that is its GPU's driver and nothing else: the NVIDIA workers link the CUDA runtime
# statically or ship it (libcudart.so.12); the AMD workers ship AMD's HIP runtime they were built with;
# the Intel workers ship oneAPI's SYCL runtime and Intel's compute stack, built here from source
# (dist-intel). .github/workflows/release.yml checks that on real GPUs, in stock distribution images.

# ---------------------------------------------------------------------------
# Build args (all overridable)
# ---------------------------------------------------------------------------
ARG RUST_VERSION=1.97.1
ARG CUDA_VERSION=12.8.0
# sp1-gpu-server alone: see the sp1-server-cuda-rust-base stage.
ARG SP1_SERVER_CUDA_VERSION=12.9.2
ARG UBUNTU_VERSION=22.04
ARG FOUNDRY_VERSION=v1.3.5
# nvcc compiles each kernel file for this many GPU targets at once (see build-cuda). CI raises it on a
# runner with the memory for it.
ARG NVCC_THREADS=2
# cargo-chef: the risc0 workers build their dependencies, the GPU kernels among them, in a layer of
# their own, keyed on Cargo.lock and the manifests (see the planner stage).
ARG CARGO_CHEF_VERSION=0.1.78
# AMD: AMD's ROCm 10.1 for Ubuntu 22.04 (earlier ROCm gives invalid SP1 proofs, hemilabs/sp1 #19 needs
# 7.2 or later), and the GPUs compiled for: gfx1100 (RX 7900), gfx1101 (RX 7800/7700), gfx1102
# (RX 7600), gfx1200 (RX 9060), gfx1201 (RX 9070).
ARG ROCM_VERSION=10.1
ARG ROCM_PKG_VERSION=10.1.0-3
ARG AMD_GPU_TARGETS=gfx1100,gfx1101,gfx1102,gfx1200,gfx1201
# The risc0 prover, compiled with ROCm 7.1, for the same five exact targets. Not gfx11-generic, the one
# code object every RX 7000 could run: built for it, the prover's proofs fail verification on an RX
# 7900 XTX (all six benchmarks, "check != result"), where the same build for gfx1100 proves them all.
ARG RISC0_AMD_GPU_TARGETS=gfx1100,gfx1101,gfx1102,gfx1200,gfx1201
# hipcc compiles a file's GPU targets this many at a time (clang's -parallel-jobs), which multiplies
# the compiler's memory by as much. CI raises it on a runner with the memory for it.
ARG HIP_PARALLEL_JOBS=1
# Intel: oneAPI DPC++ 2026.0, and the GPUs the risc0 kernels are compiled for ahead of time: Battlemage
# (bmg_g21: Arc B580/B570; bmg_g31: B-series Pro) and Alchemist (acm_g10: Arc A770/A750/A580), plus
# SPIR-V, which the shipped compiler builds on first use for any other Intel GPU (A380, A310). SP1's
# SYCL build compiles the same set by default.
ARG ONEAPI_VERSION=2026.0
ARG ONEAPI_PKG_VERSION=2026.0.0-947
ARG RISC0_INTEL_SYCL_TARGETS=intel_gpu_bmg_g21,intel_gpu_bmg_g31,intel_gpu_acm_g10,spir64

# ===========================================================================
# Stage: rust-base — Ubuntu 22.04 + Rust toolchain
# ===========================================================================
# ubuntu:22.04 — pinned 2026-03-05
FROM ubuntu:${UBUNTU_VERSION}@sha256:3ba65aa20f86a0fad9df2b2c259c613df006b2e6d0bfcc8a146afb8c525a9751 AS rust-base
ARG RUST_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates cmake pkg-config libssl-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal \
    && rustup show

ENV RUSTFLAGS="-C target-cpu=x86-64-v3 -C target-feature=+adx"

WORKDIR /build

# ===========================================================================
# Stage: planner — the dependency recipe the risc0 worker builds cook first
# ===========================================================================
# `cargo chef prepare` reduces the workspace to its manifests and Cargo.lock. The worker stages copy
# only that recipe before `cargo chef cook`, which compiles every dependency, the risc0 GPU kernels
# among them (hours, for every target). So that layer is rebuilt only when a dependency changes, and
# is reused from the build cache otherwise; a source change rebuilds zkminer's own crates alone. No
# cache mounts in those layers: the dependency sources and target dir have to be in the layer for
# the next one to reuse them.
FROM rust-base AS planner
ARG CARGO_CHEF_VERSION
RUN cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
COPY . .
RUN cargo chef prepare --recipe-path /recipe.json

# ===========================================================================
# Stage: build-cli — the main zkminer CLI binary
# ===========================================================================
FROM rust-base AS build-cli

COPY . .

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=target-cli,target=/build/target \
    cargo build --release -p zkminer-cli --bin zkminer \
    && cp target/release/zkminer /zkminer

# ===========================================================================
# Stage: e2e — end-to-end tests that drive the built zkminer binary
#
#   make e2e
#
# Builds zkminer + mock-worker and the test binaries into the image; the tests
# run at `docker run` time. No cache mounts: `cargo test` at run time needs the
# registry sources and target/ that the build steps produced.
# ===========================================================================
FROM rust-base AS e2e
ARG FOUNDRY_VERSION

# anvil, for the local-chain fixture
ENV FOUNDRY_DIR=/usr/local/foundry \
    PATH="/usr/local/foundry/bin:${PATH}"
RUN curl -L https://foundry.paradigm.xyz | bash \
    && foundryup --install ${FOUNDRY_VERSION} \
    && anvil --version

COPY . .

# Separate builds so the `testing` feature isn't unified into `zkminer`.
RUN cargo build -p zkminer-cli --bin zkminer \
    && cargo build -p zkminer-prover --features testing --bin mock-worker \
    && cargo test -p zkminer-e2e --no-run

ENV ZKMINER_E2E_BIN_DIR=/build/target/debug
CMD ["cargo", "test", "-p", "zkminer-e2e"]

# ===========================================================================
# Stage: build-cli-windows — Windows CLI via cargo-xwin cross-compilation
# ===========================================================================
FROM rust-base AS build-cli-windows

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang lld llvm \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-pc-windows-msvc \
    && cargo install cargo-xwin

COPY . .

# Statically link the MSVC runtime so the .exe runs on a clean Windows box without
# the Visual C++ redistributable. This stage inherited only `+adx` from rust-base,
# which dynamically links vcruntime -- fine as a compile check, but it made the
# shipped binary depend on something the user has to install first. The native
# Windows CI job already used `+crt-static`; the two now agree.
ENV RUSTFLAGS="-C target-cpu=x86-64-v3 -C target-feature=+crt-static"

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=target-cli-windows,target=/build/target \
    cargo xwin build --release --target x86_64-pc-windows-msvc \
        -p zkminer-cli --bin zkminer \
    && cp target/x86_64-pc-windows-msvc/release/zkminer.exe /zkminer.exe

# ===========================================================================
# Stage: build-openvm — OpenVM prover binary
# ===========================================================================
FROM rust-base AS build-openvm

COPY . .

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=target-openvm,target=/build/target \
    cargo build --release --manifest-path crates/zkminer-prove-openvm/Cargo.toml \
        --bin zkminer-prove-openvm --target-dir target \
    && cp target/release/zkminer-prove-openvm /zkminer-prove-openvm

# ===========================================================================
# Stage: cuda-rust-base — NVIDIA CUDA + Rust toolchain
# ===========================================================================
# nvidia/cuda:12.8.0-devel-ubuntu22.04 — pinned 2026-03-05
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu22.04@sha256:54f18e2a8e1b3d03f77b9a6dc905533da46ac93a5513f10e8ba8e560db9fa5ab AS cuda-rust-base
ARG RUST_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates cmake pkg-config \
        protobuf-compiler libclang-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal \
    && rustup show

ENV RUSTFLAGS="-C target-cpu=x86-64-v3 -C target-feature=+adx"

WORKDIR /build

# ===========================================================================
# Stage: sp1-server-cuda-rust-base — cuda-rust-base, on CUDA 12.9 for sp1-gpu-server
# ===========================================================================
# The same stage as cuda-rust-base on a newer CUDA 12, for the one binary measured to gain from it.
# sp1-gpu-server built by this recipe with 12.9.2 instead of 12.8.0, nothing else different, proved
# 4.3% faster on an RTX 5080 (Blackwell) over four alternating rounds and the same on an RTX 4090
# (2026-10-11). 13.3 was 5.2% faster, but CUDA 13 needs driver 580 where any CUDA 12 runs on 525.
# The risc0 worker stays on 12.8 until it has been measured the same way.
# nvidia/cuda:12.9.2-devel-ubuntu22.04 — pinned 2026-10-11
FROM nvidia/cuda:${SP1_SERVER_CUDA_VERSION}-devel-ubuntu22.04@sha256:e0203e3a0d3d02b05f4210867b973b7f48997c71bc99b994f2bd350ee60f77a1 AS sp1-server-cuda-rust-base
ARG RUST_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates cmake pkg-config \
        protobuf-compiler libclang-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal \
    && rustup show

ENV RUSTFLAGS="-C target-cpu=x86-64-v3 -C target-feature=+adx"

WORKDIR /build

# ===========================================================================
# Stage: cuda-base — cuda-rust-base + the RISC Zero toolchain
# ===========================================================================
# Only the risc0 CUDA build needs this, so the SP1 stages start from cuda-rust-base and never wait
# on GitHub's API, which `rzup install` calls.
FROM cuda-rust-base AS cuda-base

RUN apt update
RUN apt install -y curl 
RUN curl -L https://risczero.com/install | bash
RUN cat "/root/.bashrc"
ENV PATH="$PATH:/root/.risc0/bin"
RUN echo blah
RUN rzup --help
RUN rzup install --help
# rzup asks GitHub's API for the latest release. Unauthenticated, that is limited per IP, which CI
# runners share, and it failed builds. CI passes its token as the `github_token` secret, which rzup
# reads as GITHUB_TOKEN, and which never goes into a layer or the cache. Without the secret (a local
# build) it runs unauthenticated, as before.
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN rzup install -f

WORKDIR /build

# ===========================================================================
# Stages: cook-cuda, build-cuda — RISC Zero CUDA prover (multi-arch portable)
# ===========================================================================
# cook-cuda compiles the dependencies, the GPU kernels among them; build-cuda the prover on top. The
# first is a stage of its own so that CI can save it to the build cache before building on
# (build-docker.yml, `checkpoints`): the kernels take hours on a standard runner, and a build that
# fails later would otherwise save none of it. The same goes for cook-rocm and cook-intel.
FROM cuda-base AS cook-cuda
ARG CARGO_CHEF_VERSION
ARG NVCC_THREADS

# GPU targets: native code for every family from Turing up — sm_75 (RTX 20, T4), sm_80 (A100),
# sm_86 (RTX 30, A10, A40, A6000), sm_89 (RTX 40, L4, L40), sm_90 (H100, H200), sm_100 (B200, and B300
# runs it) and sm_120 (RTX 50, RTX PRO 6000, and GB10 runs it) — plus compute_120 PTX, so a later
# architecture can still JIT it. A card outside the list is refused when the miner starts rather than
# claiming work it cannot prove: the dispatcher reads which architectures this binary carries
# (crates/zkminer-prover/src/gpu_code.rs).
#
# `--threads 2` compiles each file's targets two at a time rather than one after another. The long pole
# of this image is risc0-circuit-rv32im-sys's 3 MB steps.cu, a single nvcc call that took ~24 minutes
# for one target and one PTX on the 4-core runner; serially, eight targets would take it past two hours.
# Not four at a time: beside cargo's four jobs that peaked at 16.8 GB of compiler memory, more than the
# runner's 16 GB. Two at a time built under a 14 GiB cap with no swap, peaking at 10.6 GB (2026-10-10),
# but the kernels of the current risc0 pin ran the 16 GB runner out of memory at two (2026-11-03), so
# CI passes NVCC_THREADS=1 there, and 4 on a larger runner.
ENV NVCC_APPEND_FLAGS="--threads ${NVCC_THREADS} \
    -gencode arch=compute_75,code=sm_75 -gencode arch=compute_80,code=sm_80 \
    -gencode arch=compute_86,code=sm_86 -gencode arch=compute_89,code=sm_89 \
    -gencode arch=compute_90,code=sm_90 -gencode arch=compute_100,code=sm_100 \
    -gencode arch=compute_120,code=[sm_120,compute_120]"

RUN cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
COPY --from=planner /recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json \
        -p zkminer-prove-risc0 --features cuda --bin zkminer-prove-risc0-cuda

FROM cook-cuda AS build-cuda
COPY . .

RUN cargo build --release -p zkminer-prove-risc0 --features cuda --bin zkminer-prove-risc0-cuda \
    && cp target/release/zkminer-prove-risc0-cuda /zkminer-prove-risc0-cuda

# ===========================================================================
# Stage: build-sp1 — SP1 prover (requires CUDA base, sp1-sdk hardcodes cuda)
# ===========================================================================
FROM cuda-rust-base AS build-sp1

RUN apt update
RUN apt install -y protobuf-compiler libprotobuf-dev

# Install succinct/sp1 toolchain (pinned to match sp1-sdk version in Cargo.lock)
RUN curl -L https://sp1up.succinct.xyz | bash \
    && /root/.sp1/bin/sp1up --version 6.0.1

ENV PATH="/root/.sp1/bin:${PATH}"

COPY . .

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=target-sp1,target=/build/target \
    cargo build --release -p zkminer-prove-sp1 --bin zkminer-prove-sp1 \
    && cp target/release/zkminer-prove-sp1 /zkminer-prove-sp1

# ===========================================================================
# Stage: build-sp1-server — sp1-gpu-server from the hemilabs/sp1 commit Cargo.lock pins
# ===========================================================================
# The SP1 SDK runs ~/.sp1/bin/sp1-gpu-server and, without one, downloads upstream's build, which has
# none of the fork's GPU fixes (Blackwell faults, the 16 GB tier) and whose `--version` matches the
# fork's, so the SDK cannot tell. The release therefore ships this one beside zkminer-prove-sp1,
# which installs it. It is built from the exact commit Cargo.lock records for the SDK, so the two can
# never disagree, using that commit's own Cargo.lock.
FROM sp1-server-cuda-rust-base AS build-sp1-server

# sp1-prover-types' protos import google/protobuf/empty.proto, which Ubuntu ships in libprotobuf-dev:
# protobuf-compiler only recommends it, and cuda-rust-base installs without recommends.
RUN apt-get update && apt-get install -y --no-install-recommends libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

# sp1-gpu-sys needs CMake 3.30 or later, and Ubuntu 22.04's is 3.22. This is Kitware's build, of the
# version the server has been built with outside Docker. /usr/local/bin comes first on PATH.
ARG CMAKE_VERSION=3.31.6
ARG CMAKE_SHA256=5a1133ff103c71eb5120e2cc3de922733e7d8a26a98ae716397e8676adb367bf
RUN curl -fsSL -o /tmp/cmake.tgz \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
    && echo "${CMAKE_SHA256}  /tmp/cmake.tgz" | sha256sum -c - \
    && tar -C /usr/local --strip-components=1 -xzf /tmp/cmake.tgz \
    && rm /tmp/cmake.tgz \
    && cmake --version

# gnark's Groth16/PLONK provers are linked into the server through cgo.
ARG GO_VERSION=1.24.13
ARG GO_SHA256=1fc94b57134d51669c72173ad5d49fd62afb0f1db9bf3f798fd98ee423f8d730
RUN curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    && echo "${GO_SHA256}  /tmp/go.tgz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz
ENV PATH="/usr/local/go/bin:${PATH}"
# SP1's gnark FFI (upstream's as much as the fork's) imports
# github.com/consensys/gnark-ignition-verifier at a version proxy.golang.org does not serve, from a
# GitHub repository that no longer exists, so a fresh module cache can fetch it from neither.
# goproxy.cn still serves it. Go only asks it for what proxy.golang.org answers 404 to, and checks
# every download against the hash go.sum pins (h1:z42ewLaL... for this one), so a copy that differs
# fails the build rather than going into it.
ENV GOPROXY="https://proxy.golang.org,https://goproxy.cn,direct"

# GPU targets: the families the fork itself builds by default on CUDA 12.8 and later — sm_80 (A100), sm_86
# (RTX 30, A10, A40, A6000), sm_89 (RTX 40, L4, L40), sm_90 (H100, H200), sm_100 (B200, and B300 runs
# it) and sm_120 (RTX 50, RTX PRO 6000, and GB10 runs it). No PTX: with relocatable device code the
# linked image the runtime loads is native code only, whatever the objects carry. SP1 needs 16 GB of
# VRAM, which leaves few cards older than these. One outside the list is refused when the miner
# starts, as for the risc0 worker above (crates/zkminer-prover/src/gpu_code.rs).
ARG SP1_CUDA_ARCHS=80,86,89,90,100,120

COPY Cargo.lock /build/Cargo.lock

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=target-sp1-server,target=/build/target-sp1-server \
    REV=$(grep -o 'git+https://github.com/hemilabs/sp1?[^#"]*#[0-9a-f]\{40\}' /build/Cargo.lock | head -1 | cut -d'#' -f2) \
    && test -n "$REV" \
    && echo "building sp1-gpu-server at hemilabs/sp1 $REV" \
    && CUDA_ARCHS="${SP1_CUDA_ARCHS}" CARGO_TARGET_DIR=/build/target-sp1-server \
       cargo install --locked --root /sp1-server --git https://github.com/hemilabs/sp1 --rev "$REV" sp1-gpu-server \
    && cp /sp1-server/bin/sp1-gpu-server /sp1-gpu-server

# The CUDA runtime the server is linked against, shipped beside zkminer-prove-sp1 so a host needs
# only the NVIDIA driver: the worker puts its own directory on the server's library path. NVIDIA's
# CUDA EULA lists libcudart.so among the files an application may distribute (Attachment A), as
# unmodified object code (2.3), under terms consistent with its own. So it is copied byte for byte
# from this image, and ships with a notice and the EULA that came with this copy (Ubuntu images
# keep /usr/share/doc/*/copyright). The build fails if the server stops needing exactly
# libcudart.so.12, rather than ship a runtime it does not load.
RUN <<'EOF'
set -eu
readelf -d /sp1-gpu-server | grep -q 'NEEDED.*\[libcudart\.so\.12\]' || {
    echo "sp1-gpu-server no longer needs libcudart.so.12; update what ships beside it" >&2
    exit 1
}
lib=$(readlink -f /usr/local/cuda/lib64/libcudart.so.12)
pkg=$(dpkg -S "$lib" | cut -d: -f1)
version=$(dpkg-query -W -f='${Version}' "$pkg")
eula="/usr/share/doc/$pkg/copyright"
grep -q 'libcudart.so, libcudart_static.a' "$eula"
mkdir /cudart
cp "$lib" /cudart/libcudart.so.12
cmp "$lib" /cudart/libcudart.so.12
{
    cat <<NOTICE
libcudart.so.12 is the NVIDIA CUDA Runtime, version $version (NVIDIA package $pkg),
copied unmodified from NVIDIA's CUDA container image.

It is NOT covered by zkminer's MIT license. It is NVIDIA's software, distributed with
zkminer under the NVIDIA CUDA Toolkit End User License Agreement that came with this copy,
which follows in full. That agreement lists libcudart.so among the files that may be
distributed with an application (Attachment A).

It ships so that sp1-gpu-server, which zkminer-prove-sp1 runs, can start on a host without
a CUDA 12 toolkit. It is for use by zkminer, and is not offered on its own.

================================================================================

NOTICE
    cat "$eula"
} > /cudart/libcudart.so.12.LICENSE.txt
EOF

# ===========================================================================
# Stage: rocm-toolchain — Ubuntu 22.04 + Rust + AMD's ROCm 10.1, for SP1's HIP server
# ===========================================================================
# ROCm from AMD's own Ubuntu 22.04 repository rather than a ROCm image: the image is the same Ubuntu
# 22.04 as every other binary here, and only what the build uses is installed: the HIP runtime and
# compiler (amdrocm-runtime-dev pulls in amdrocm-llvm-dev), and hipcub/rocprim/rocthrust
# (amdrocm-ccl-dev). The repository key is checked against its hash. (The risc0 prover is built with
# ROCm 7.1: see rocm71-toolchain.)
FROM rust-base AS rocm-toolchain
ARG ROCM_VERSION
ARG ROCM_PKG_VERSION
ARG ROCM_KEY_SHA256=090a4bf906822c5eb450ae8024b728b9281f2fccb0304641eb75018e4ec6a6dd

RUN install -d /etc/apt/keyrings \
    && curl -fsSL -o /etc/apt/keyrings/amdrocm.asc https://stable.repo.amd.com/rocm/gpg/packages.gpg \
    && echo "${ROCM_KEY_SHA256}  /etc/apt/keyrings/amdrocm.asc" | sha256sum -c - \
    && printf '%s\n' 'Types: deb' 'URIs: https://stable.repo.amd.com/rocm/core/packages/ubuntu2204/' \
        'Suites: stable' 'Components: main' 'Architectures: amd64' \
        'Signed-By: /etc/apt/keyrings/amdrocm.asc' > /etc/apt/sources.list.d/amdrocm.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends libclang-dev file \
        amdrocm-runtime-dev${ROCM_VERSION}=${ROCM_PKG_VERSION} \
        amdrocm-runtime${ROCM_VERSION}=${ROCM_PKG_VERSION} \
        amdrocm-llvm-dev${ROCM_VERSION}=${ROCM_PKG_VERSION} \
        amdrocm-llvm${ROCM_VERSION}=${ROCM_PKG_VERSION} \
        amdrocm-sysdeps${ROCM_VERSION}=${ROCM_PKG_VERSION} \
        amdrocm-ccl-dev${ROCM_VERSION}=${ROCM_PKG_VERSION} \
    && rm -rf /var/lib/apt/lists/* \
    && /opt/rocm/core-${ROCM_VERSION}/bin/hipcc --version | head -n 3

ENV ROCM_PATH=/opt/rocm/core-${ROCM_VERSION} \
    HIP_PATH=/opt/rocm/core-${ROCM_VERSION} \
    PATH="${PATH}:/opt/rocm/core-${ROCM_VERSION}/bin"

# ===========================================================================
# Stage: rocm71-toolchain — AMD's ROCm 7.1 image + Rust + the RISC Zero toolchain
# ===========================================================================
# The risc0 ROCm prover's kernels are compiled with ROCm 7.1, the compiler they were validated with
# on an RX 7900 XTX, not 10.1: ROCm 10.1's compiler gives the witness kernel par_stepExecW2 every
# implicit kernel argument, the hostcall buffer among them (it can no longer prove the kernel uses
# none), and a kernel with a hostcall buffer cannot launch on a card without PCIe atomics
# ("hostcall not supported", "AQL dispatch failed"), even with asserts compiled out and printf
# buffered. ROCm 7.1's leaves it out. The prover ships with ROCm 7.1's runtime (build-rocm), and
# SP1's HIP server, which needs 7.2 or later, with ROCm 10.1's (build-sp1-server-hip): each runs on
# the runtime of the toolchain it was compiled and validated with.
#
# Its clang is ROCm 7.1's own, rebuilt with one compile-time fix (rocm71-clang below).
# rocm/dev-ubuntu-22.04:7.1 — ROCm 7.1.0, pinned 2026-11-03
FROM rocm/dev-ubuntu-22.04:7.1@sha256:f55ecea640588a014b9a0fcaba596ed9f79656bffea23644e73f9928280103a5 AS rocm71-clang
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates cmake ninja-build patch zlib1g-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/ci/build-rocm71-clang.sh /usr/local/bin/
COPY scripts/ci/patches/llvm-rocm-7.1-codegenprepare-comesbefore.patch /usr/local/bin/patches/
RUN build-rocm71-clang.sh /out

FROM rocm/dev-ubuntu-22.04:7.1@sha256:f55ecea640588a014b9a0fcaba596ed9f79656bffea23644e73f9928280103a5 AS rocm71-toolchain
ARG RUST_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates cmake pkg-config libssl-dev \
        protobuf-compiler libclang-dev file \
        hipcub-dev rocthrust-dev rocprim-dev \
    && rm -rf /var/lib/apt/lists/*

# ROCm 7.1's clang with upstream LLVM's fix for a quadratic loop in CodeGenPrepare
# (scripts/ci/build-rocm71-clang.sh). It generates the same code, and compiles risc0's RDNA4
# (gfx1200, gfx1201) eval_check in minutes rather than hours per target.
COPY --from=rocm71-clang /out/bin/clang-20 /opt/rocm-7.1.0/lib/llvm/bin/clang-20
RUN /opt/rocm/lib/llvm/bin/clang --version | head -n 1 | grep -q 'zkminer-codegenprepare' \
    && /opt/rocm/bin/hipcc --version | head -n 3

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}:/root/.risc0/bin" \
    ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal \
    && rustup show

ENV RUSTFLAGS="-C target-cpu=x86-64-v3 -C target-feature=+adx"

# rzup: see cuda-base (GITHUB_TOKEN).
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN \
    curl -fsSL https://risczero.com/install | bash && rzup install -f

WORKDIR /build

# ===========================================================================
# Stages: cook-rocm, build-rocm — RISC Zero ROCm prover
# ===========================================================================
# RISC0_HIP_ARCH names the GPUs compiled for; every risc0 HIP build script honours it. The release
# build has device asserts compiled out and device printf buffered (-DNDEBUG -mprintf-kind=buffered),
# which is the build validated on an RX 7900 XTX, and which needs no PCIe atomics: an assert or a
# printf otherwise makes a kernel use hostcall, which cannot launch on a card without them (some
# platforms, VMs, eGPU enclosures). The binary's RPATH finds the HIP runtime shipped beside it
# (crates/zkminer-prove-risc0/build.rs, staged below).
FROM rocm71-toolchain AS cook-rocm
ARG CARGO_CHEF_VERSION
ARG RISC0_AMD_GPU_TARGETS
ARG HIP_PARALLEL_JOBS
ENV HIPCC=/opt/rocm/bin/hipcc \
    NVCC=off \
    RISC0_HIP_ARCH=${RISC0_AMD_GPU_TARGETS} \
    HIPCC_COMPILE_FLAGS_APPEND="-DNDEBUG -mprintf-kind=buffered -parallel-jobs=${HIP_PARALLEL_JOBS}"

RUN cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
COPY --from=planner /recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json \
        -p zkminer-prove-risc0 --features rocm --bin zkminer-prove-risc0-rocm

# See cook-cuda.
FROM cook-rocm AS build-rocm
COPY . .

# With the HIP runtime it was compiled against, ROCm 7.1's, in zkminer-rocm/ (lib/, LICENSES/), which
# the binary's RPATH names: scripts/ci/stage-rocm-runtime.sh.
RUN cargo build --release -p zkminer-prove-risc0 --features rocm --bin zkminer-prove-risc0-rocm \
    && mkdir -p /stage \
    && cp target/release/zkminer-prove-risc0-rocm /stage/ \
    && readelf -d /stage/zkminer-prove-risc0-rocm | grep -q 'RPATH.*\$ORIGIN/zkminer-rocm/lib' \
    && scripts/ci/stage-rocm-runtime.sh /opt/rocm /stage/zkminer-rocm

# ===========================================================================
# Stage: build-sp1-server-hip — hemilabs/sp1's sp1-gpu-server, HIP build
# ===========================================================================
# The same commit as build-sp1-server (Cargo.lock's), built for AMD GPUs (#19) with ROCm 10.1 (it needs
# 7.2 or later). Shipped as sp1-gpu-server-hip; the dispatcher has the SP1 worker run it for an AMD
# card. Device printf buffered,
# as for build-rocm (Release builds already compile asserts out). CMake is told the ROCm root, which
# it does not find from the compiler path in ROCm 10's layout.
FROM rocm-toolchain AS build-sp1-server-hip
ARG ROCM_VERSION
ARG AMD_GPU_TARGETS
COPY scripts/ci/install-sp1-server-tools.sh /usr/local/bin/
RUN install-sp1-server-tools.sh
# GOPROXY: see build-sp1-server.
ENV PATH="/usr/local/go/bin:${PATH}" \
    GOPROXY="https://proxy.golang.org,https://goproxy.cn,direct"
RUN printf 'set(CMAKE_HIP_COMPILER_ROCM_ROOT "/opt/rocm/core-%s")\n' "${ROCM_VERSION}" \
        > /usr/local/share/hip-rocm-root.cmake
ENV SP1_GPU_BACKEND=hip \
    HIP_ARCHS=${AMD_GPU_TARGETS} \
    HIPCXX=/opt/rocm/core-${ROCM_VERSION}/lib/llvm/bin/clang++ \
    HIPFLAGS="-mprintf-kind=buffered" \
    CMAKE_TOOLCHAIN_FILE=/usr/local/share/hip-rocm-root.cmake

COPY Cargo.lock /build/Cargo.lock

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=target-sp1-server-hip,target=/build/target-sp1-server \
    REV=$(grep -o 'git+https://github.com/hemilabs/sp1?[^#"]*#[0-9a-f]\{40\}' /build/Cargo.lock | head -1 | cut -d'#' -f2) \
    && test -n "$REV" \
    && echo "building sp1-gpu-server (HIP: ${HIP_ARCHS}) at hemilabs/sp1 $REV" \
    && CARGO_TARGET_DIR=/build/target-sp1-server \
       cargo install --locked --root /sp1-server --git https://github.com/hemilabs/sp1 --rev "$REV" sp1-gpu-server \
    && mkdir -p /stage \
    && cp /sp1-server/bin/sp1-gpu-server /stage/sp1-gpu-server-hip \
    && readelf -d /stage/sp1-gpu-server-hip | grep -q 'NEEDED.*\[libamdhip64\.so\.7\]'

# With the HIP runtime it was compiled against, ROCm 10.1's, as sp1-gpu-server-hip-lib/ (the
# libraries, and their licenses in LICENSES/), which the SP1 worker puts on the server's library path.
COPY scripts/ci/stage-rocm-runtime.sh /usr/local/bin/
RUN stage-rocm-runtime.sh /opt/rocm/core-${ROCM_VERSION} /tmp/hip-runtime \
    && mv /tmp/hip-runtime/lib /stage/sp1-gpu-server-hip-lib \
    && mv /tmp/hip-runtime/LICENSES /stage/sp1-gpu-server-hip-lib/LICENSES

# ===========================================================================
# Stages: intel-igc, intel-gpu-runtime — Intel's GPU compute stack, built from source for glibc 2.35
# ===========================================================================
# IGC and gmmlib, then the compute runtime (with ocloc) and the Level Zero loader, at the versions the
# Intel workers were validated with (scripts/ci/build-intel-igc.sh, build-intel-gpu-runtime.sh).
# Intel's packages of them need glibc 2.38. IGC builds LLVM 16 (over an hour on a standard runner),
# so it is a stage of its own, which depends only on its script and the shared one: the build cache
# keeps it while the rest changes, and CI saves it before building on (build-docker.yml,
# `checkpoints`).
FROM ubuntu:${UBUNTU_VERSION}@sha256:3ba65aa20f86a0fad9df2b2c259c613df006b2e6d0bfcc8a146afb8c525a9751 AS intel-igc
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ca-certificates python3 python3-mako python3-yaml \
        bison flex pkg-config zlib1g-dev libzstd-dev patchelf file \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/ci/intel-gpu-build-lib.sh scripts/ci/build-intel-igc.sh /usr/local/bin/
COPY scripts/ci/patches/igc-2.28.4-mergeallocas-start-index.patch /usr/local/bin/patches/
RUN build-intel-igc.sh /opt/zkminer-intel-gpu && rm -rf /tmp/intel-gpu-src

FROM intel-igc AS intel-gpu-runtime
COPY scripts/ci/build-intel-gpu-runtime.sh /usr/local/bin/
RUN build-intel-gpu-runtime.sh /opt/zkminer-intel-gpu && rm -rf /tmp/intel-gpu-src

# ===========================================================================
# Stage: intel-toolchain — Ubuntu 22.04 + Rust + oneAPI DPC++ + the Intel GPU stack + RISC Zero
# ===========================================================================
# oneAPI from Intel's apt repository (key checked against its hash), the compiler alone, and Python,
# which the risc0 Intel kernels' build scripts run (standard library only). The kernels
# are compiled ahead of time with the ocloc built above, the same version the release ships, which
# icpx finds on PATH; the Level Zero headers and loader come from there too.
FROM rust-base AS intel-toolchain
ARG ONEAPI_VERSION
ARG ONEAPI_PKG_VERSION
ARG ONEAPI_KEY_SHA256=db932ba032a71f732dc415eef5f4f185fc7ae768487d7a357bc2772746b6c48c

RUN install -d /etc/apt/keyrings \
    && curl -fsSL -o /etc/apt/keyrings/intel-oneapi.asc \
        https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    && echo "${ONEAPI_KEY_SHA256}  /etc/apt/keyrings/intel-oneapi.asc" | sha256sum -c - \
    && echo "deb [signed-by=/etc/apt/keyrings/intel-oneapi.asc] https://apt.repos.intel.com/oneapi all main" \
        > /etc/apt/sources.list.d/oneapi.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends libclang-dev file python3 \
        intel-oneapi-compiler-dpcpp-cpp-${ONEAPI_VERSION}=${ONEAPI_PKG_VERSION} \
    && rm -rf /var/lib/apt/lists/*

COPY --from=intel-gpu-runtime /opt/zkminer-intel-gpu /opt/zkminer-intel-gpu

ENV ONEAPI_ROOT=/opt/intel/oneapi \
    RISC0_ICPX=/opt/intel/oneapi/compiler/${ONEAPI_VERSION}/bin/icpx \
    PATH="/opt/intel/oneapi/compiler/${ONEAPI_VERSION}/bin:/opt/zkminer-intel-gpu/bin:${PATH}:/root/.risc0/bin" \
    LD_LIBRARY_PATH="/opt/intel/oneapi/compiler/${ONEAPI_VERSION}/lib:/opt/intel/oneapi/umf/latest/lib:/opt/intel/oneapi/tcm/latest/lib:/opt/intel/oneapi/tbb/latest/lib/intel64/gcc4.8:/opt/zkminer-intel-gpu/lib" \
    LIBRARY_PATH="/opt/intel/oneapi/compiler/${ONEAPI_VERSION}/lib:/opt/zkminer-intel-gpu/lib" \
    CPATH="/opt/zkminer-intel-gpu/include"

RUN icpx --version | head -n 1 && ocloc -version 2>/dev/null | head -n 2 || true

# rzup: see cuda-base (GITHUB_TOKEN).
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN \
    curl -fsSL https://risczero.com/install | bash && rzup install -f

# ===========================================================================
# Stages: cook-intel, build-intel — RISC Zero Intel prover, and the libraries it ships with
# ===========================================================================
# The risc0 -sys crates build their SYCL kernels as shared libraries; stage-intel-worker-libs.sh
# copies them, oneAPI's SYCL runtime and (INTEL_GPU_RUNTIME) Intel's compute stack into
# zkminer-intel/lib, which the binary's RPATH names, and their licenses into zkminer-intel/LICENSES.
FROM intel-toolchain AS cook-intel
ARG CARGO_CHEF_VERSION
ARG RISC0_INTEL_SYCL_TARGETS
ENV NVCC=off HIPCC=off RISC0_INTEL_SYCL_TARGETS=${RISC0_INTEL_SYCL_TARGETS}

RUN cargo install cargo-chef --locked --version ${CARGO_CHEF_VERSION}
COPY --from=planner /recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json \
        -p zkminer-prove-risc0 --features intel --bin zkminer-prove-risc0-intel

# See cook-cuda.
FROM cook-intel AS build-intel
COPY . .

RUN cargo build --release -p zkminer-prove-risc0 --features intel --bin zkminer-prove-risc0-intel \
    && mkdir -p /stage \
    && cp target/release/zkminer-prove-risc0-intel /stage/ \
    && INTEL_GPU_RUNTIME=/opt/zkminer-intel-gpu \
       scripts/stage-intel-worker-libs.sh /stage/zkminer-prove-risc0-intel /build/target

# ===========================================================================
# Stage: build-sp1-server-sycl — hemilabs/sp1's sp1-gpu-server, SYCL build
# ===========================================================================
# The same commit as build-sp1-server, built for Intel GPUs (#19) with its default targets (Battlemage
# and Alchemist ahead of time, plus SPIR-V). Shipped as sp1-gpu-server-sycl, with its own library
# (libsp1_gpu_sycl.so) staged with the rest into zkminer-intel/lib. No cache mount for the target dir:
# that library is built there.
FROM intel-toolchain AS build-sp1-server-sycl
COPY scripts/ci/install-sp1-server-tools.sh /usr/local/bin/
RUN install-sp1-server-tools.sh
# GOPROXY: see build-sp1-server.
ENV PATH="/usr/local/go/bin:${PATH}" \
    GOPROXY="https://proxy.golang.org,https://goproxy.cn,direct" \
    SP1_GPU_BACKEND=sycl

COPY Cargo.lock /build/Cargo.lock
COPY scripts/stage-intel-worker-libs.sh /usr/local/bin/

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    REV=$(grep -o 'git+https://github.com/hemilabs/sp1?[^#"]*#[0-9a-f]\{40\}' /build/Cargo.lock | head -1 | cut -d'#' -f2) \
    && test -n "$REV" \
    && echo "building sp1-gpu-server (SYCL) at hemilabs/sp1 $REV" \
    && CARGO_TARGET_DIR=/build/target-sp1-server \
       cargo install --locked --root /sp1-server --git https://github.com/hemilabs/sp1 --rev "$REV" sp1-gpu-server \
    && mkdir -p /stage \
    && cp /sp1-server/bin/sp1-gpu-server /stage/sp1-gpu-server-sycl \
    && INTEL_GPU_RUNTIME=/opt/zkminer-intel-gpu \
       stage-intel-worker-libs.sh /stage/sp1-gpu-server-sycl /build/target-sp1-server \
    && rm -rf /build/target-sp1-server

# ===========================================================================
# Stage: build-localnet-test — the localnet test, for the release's GPU validation
# ===========================================================================
# The every-GPU localnet test (crates/zkminer-cli/tests/localnet.rs) built on its own, with anvil, so
# the self-hosted GPU runner can run it against the release's binaries in stock distribution images
# (scripts/ci/gpu-validate.sh). Not part of the release.
FROM rust-base AS build-localnet-test
ARG FOUNDRY_VERSION
ENV FOUNDRY_DIR=/usr/local/foundry \
    PATH="/usr/local/foundry/bin:${PATH}"
RUN curl -L https://foundry.paradigm.xyz | bash \
    && foundryup --install ${FOUNDRY_VERSION} \
    && anvil --version

COPY . .

RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=target-localnet,target=/build/target \
    cargo test --release -p zkminer-cli --test localnet --no-run 2>&1 | tee /tmp/build.log \
    && exe=$(sed -n 's/.*Executable .*(\(.*\/localnet-[0-9a-f]*\)).*/\1/p' /tmp/build.log | tail -n 1) \
    && test -x "$exe" \
    && mkdir -p /localnet-test \
    && cp "$exe" /localnet-test/localnet \
    && cp /usr/local/foundry/bin/anvil /localnet-test/anvil

# ===========================================================================
# Dist stages — scratch containers for --output extraction
# ===========================================================================
FROM scratch AS dist-cli
COPY --from=build-cli /zkminer /zkminer

FROM scratch AS dist-cli-windows
COPY --from=build-cli-windows /zkminer.exe /zkminer.exe

FROM scratch AS dist-openvm
COPY --from=build-openvm /zkminer-prove-openvm /zkminer-prove-openvm

FROM scratch AS dist-cuda
COPY --from=build-cuda /zkminer-prove-risc0-cuda /zkminer-prove-risc0-cuda

FROM scratch AS dist-sp1
COPY --from=build-sp1 /zkminer-prove-sp1 /zkminer-prove-sp1

FROM scratch AS dist-sp1-server
COPY --from=build-sp1-server /sp1-gpu-server /sp1-gpu-server
COPY --from=build-sp1-server /cudart/ /

# zkminer-prove-risc0-rocm and zkminer-rocm/ (ROCm 7.1's HIP runtime)
FROM scratch AS dist-rocm
COPY --from=build-rocm /stage/ /

# sp1-gpu-server-hip and sp1-gpu-server-hip-lib/ (ROCm 10.1's HIP runtime)
FROM scratch AS dist-sp1-server-hip
COPY --from=build-sp1-server-hip /stage/ /

# Intel's compute stack alone, as built for the release: its own CI job, so that the stage is built
# once and its layers are in the build cache for the two jobs below.
FROM scratch AS dist-intel-gpu-runtime
COPY --from=intel-gpu-runtime /opt/zkminer-intel-gpu /zkminer-intel-gpu

# zkminer-prove-risc0-intel and zkminer-intel/ (lib/, LICENSES/)
FROM scratch AS dist-intel
COPY --from=build-intel /stage/ /

# sp1-gpu-server-sycl and zkminer-intel/ (its libraries; the release merges both zkminer-intel/)
FROM scratch AS dist-sp1-server-sycl
COPY --from=build-sp1-server-sycl /stage/ /

FROM scratch AS dist-localnet-test
COPY --from=build-localnet-test /localnet-test/ /
